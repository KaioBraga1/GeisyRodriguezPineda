# ─────────────────────────────────────────────────────────────
# Dra. Geisy Rodriguez Pineda — variáveis de ambiente
# Copie para `.env.local` e preencha com os dados confirmados.
# ─────────────────────────────────────────────────────────────

# URL pública canônica do site (sem barra final)
NEXT_PUBLIC_SITE_URL=https://draageisy.com.br

# Número de WhatsApp no formato internacional, apenas dígitos
# (ex.: 55 + DDD + número). [CONFIRMAR COM DRA. GEISY]
NEXT_PUBLIC_WHATSAPP_NUMBER=

# E-mail de contato profissional (opcional). [CONFIRMAR COM DRA. GEISY]
NEXT_PUBLIC_CONTACT_EMAIL=

# Fotos oficiais da Dra. Geisy.
# Basta salvar os arquivos em /public com estes nomes — não precisa mexer no .env:
#   public/dra-geisy-rodriguez-pineda.jpg   → foto do topo (hero)
#   public/dra-geisy-medica-de-familia.jpg  → foto da seção "Sobre"
# Se quiser usar OUTRO caminho/nome, defina as variáveis abaixo.
# Enquanto os arquivos não existirem, o site mostra o plate de marca (sem imagem quebrada).
NEXT_PUBLIC_HERO_PHOTO=
NEXT_PUBLIC_ABOUT_PHOTO=
